# SMTP configuration used by app/api/contact/route.ts to send contact-form emails.
# Copy this file to .env.local and fill in real values — .env.local is gitignored.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
# For Gmail, use an App Password (not your regular account password):
# https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-password
# Optional: "From" address shown to recipients. Falls back to SMTP_USER if unset.
# Note: Gmail only allows this if it's a verified alias/"Send As" address on the SMTP_USER account.
SMTP_FROM=your-email@example.com
CONTACT_TO_EMAIL=your-email@example.com

# Blog admin credentials — used to post/edit/delete blog content at /admin/blog
ADMIN_PASSWORD=choose-a-strong-password
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=generate-a-random-64-char-hex-string
