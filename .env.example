# SMTP configuration used by app/api/contact/route.ts to send contact-form emails.
# Copy this file to .env.local and fill in real values — .env.local is gitignored.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
# For Gmail, use an App Password (not your regular account password):
# https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-password
CONTACT_TO_EMAIL=your-email@example.com
